{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gurkensekte",
  "main": ".open-next/worker.js",
  // Muss <= dem Release-Datum der installierten workerd-Version sein.
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    // Node.js-APIs (node:crypto, Buffer, AsyncLocalStorage, …) für die
    // Next.js-Runtime. Ab compatibility_date 2026-08-04 ohnehin Standard.
    "nodejs_compat",
    // Erlaubt ausgehende fetch()-Calls (KI-Anbieter, Mangoe, Resend, Worker).
    "global_fetch_strictly_public"
  ],
  "assets": {
    // Statische Assets (public/ + .next/static) werden direkt vom Edge
    // ausgeliefert; der Worker läuft nur für dynamische Routen.
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Selbstreferenz – von OpenNext u. a. für interne Requests gebraucht.
      // Der Name muss dem "name" dieses Workers entsprechen.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gurkensekte"
    }
  ],
  "observability": {
    "enabled": true
  },
  // R2-Bucket als Incremental Cache: nur nötig, sobald ISR bzw.
  // revalidatePath/revalidateTag genutzt wird (siehe open-next.config.ts).
  // Dann hier einkommentieren und den Bucket vorher anlegen:
  //   npx wrangler r2 bucket create gurkensekte-opennext-cache
  //
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "gurkensekte-opennext-cache"
  //   }
  // ]
  //
  // Bilder-Optimierung über Cloudflare Images (next/image) – aktuell nicht
  // genutzt, daher deaktiviert. Zum Aktivieren einkommentieren:
  //
  // "images": { "binding": "IMAGES" }
  //
  // Nicht-geheime Runtime-Variablen (Secrets gehören NICHT hierher, sondern
  // via `npx wrangler secret put <NAME>` bzw. ins Dashboard).
  // Wichtig: Ein Deploy überschreibt die Worker-Konfiguration mit dieser
  // Datei – alles, was nur im Dashboard steht, wird dabei gelöscht.
  "vars": {
    "HEXCLAVE_PROJECT_ID": "3c0b2ba0-5d41-4738-83a5-5c819c16807b",
    "NEXT_PUBLIC_HEXCLAVE_PROJECT_ID": "3c0b2ba0-5d41-4738-83a5-5c819c16807b",
    "MANGOE_URL": "https://payments.mangoe.de",
    "NEXT_PUBLIC_MANGOE_URL": "https://payments.mangoe.de",
    "MANGOE_PAYMENT_LINK_SLUG": "gurkenglas-spende-0vrd1",
    "GURKENMAIL_INBOUND_URL": "https://gurkenmail-inbound.sdtoll.workers.dev",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFCmLsBloezlXcr2",
    "NEXT_PUBLIC_CAP_SERVER_URL": "https://cap.sdtoll.de",
    // Öffentlicher Site-Key aus dem Cap-Dashboard. Das Secret liegt als
    // Worker-Secret CAP_SECRET_KEY vor und gehört nicht in diese Datei.
    "NEXT_PUBLIC_CAP_SITE_KEY": "7aa7d62f32",
    "CAP_SITE_KEY": "7aa7d62f32",
    "NEXT_PUBLIC_IDLEN_API_KEY": "idl_pk_a8dac95f149c75923106145544193bb0c0a06e09e04d9d248f9ea980a28ee7be"
  }
}
