# Hexclave Auth (optional – needed for /mitglieder area)
HEXCLAVE_PROJECT_ID=your_hexclave_project_id_here
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=your_hexclave_project_id_here
HEXCLAVE_SECRET_SERVER_KEY=your_hexclave_secret_server_key_here

# OpenRouter API Keys (required for Gürkchen-Chat)
# Bei Fehlschlag wird automatisch der nächste Key probiert.
# OPENROUTER_API_KEY_2, OPENROUTER_API_KEY_3, … werden ebenfalls erkannt.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_API_KEY_2=your_fallback_key_here

# Cloudflare Turnstile (Bot-Schutz für Chat, Zitate, Punkte-Aktionen, Casino)
# Ohne diese Keys wird die Captcha-Prüfung übersprungen (nur für Dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Kanonische öffentliche Origin der Seite (z. B. https://gurkensekte.de).
# Wird für Links in E-Mails an die Sekten-Leitung verwendet – schützt vor
# Host-Header-Poisoning über x-forwarded-host. Ohne Wert wird der
# Request-Host als Fallback genommen.
# Wird außerdem für Mangoe successUrl/cancelUrl genutzt.
SITE_URL=https://gurkensekte.de

# Mangoe Payments (Spenden via eingebettetem Checkout).
# Instanz-URL + öffentlicher Slug; der Secret-Key gehört NUR auf den Server.
MANGOE_URL=https://payments.mangoe.de
NEXT_PUBLIC_MANGOE_URL=https://payments.mangoe.de
MANGOE_PAYMENT_LINK_SLUG=dein-spenden-link-slug
MANGOE_API_KEY=your_mangoe_api_key_here
# Optional, erst nötig sobald du Webhooks statt Polling nutzt:
# MANGOE_WEBHOOK_SECRET=your_mangoe_webhook_secret_here

# Upstash Redis (Rate-Limit über alle Serverless-Instanzen hinweg).
# Auf Vercel einfach einen KV-Store (Upstash) anlegen und verknüpfen.
# Gelesen werden (Standard zuerst):
# URL:   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_KV_REST_API_URL / KV_REST_API_URL
# Token: UPSTASH_REDIS_REST_TOKEN / UPSTASH_REDIS_REST_KV_REST_API_TOKEN / KV_REST_API_TOKEN
# Lokal optional: Ohne diese Werte greift ein In-Memory-Fallback pro Instanz.
# WICHTIG: Für GurkenMail-Adressvergabe ist Upstash in Production Pflicht
# (globale Eindeutigkeit via SET NX), sonst 503.
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# GurkenMail (Versand via Resend, Empfang via Cloudflare Worker).
# Domain für name@... (Default: gurkensekte.de).
# GURKENMAIL_DOMAIN=gurkensekte.de
# Resend: Free = 3.000/Monat, max. 100/Tag accountweit!
RESEND_API_KEY=your_resend_api_key_here
# Empfangs-Worker (D1): URL + geteiltes Secret, sonst zeigt die Inbox
# "Empfang wird gerade freigeschaltet".
# GURKENMAIL_INBOUND_URL=https://gurkenmail-inbound.<account>.workers.dev
# GURKENMAIL_INBOUND_SECRET=your_inbound_api_secret_here
