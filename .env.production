# ÖFFENTLICHE Werte, die bereits beim Build gebraucht werden.
#
# `next build` lädt diese Datei automatisch; `opennextjs-cloudflare build`
# bettet sie zusätzlich als Laufzeit-Fallback in den Worker ein. Deshalb hier
# NIEMALS Secrets eintragen – die gehören als Worker-Secret ins Dashboard.
#
# Die Werte müssen zu den `vars` in `wrangler.jsonc` passen. Runtime-Variablen
# des Workers haben Vorrang, aber `NEXT_PUBLIC_*` wird beim Build fest in den
# Client-Bundle eingebettet und kann zur Laufzeit nicht mehr geändert werden.
# Das Hexclave-SDK wird beim Sammeln der Seitendaten instanziiert und braucht
# die Projekt-ID schon dann – ohne diese Datei bricht ein Build auf einer
# frischen CI-Kopie (Workers Builds) ab.

HEXCLAVE_PROJECT_ID=3c0b2ba0-5d41-4738-83a5-5c819c16807b
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=3c0b2ba0-5d41-4738-83a5-5c819c16807b

NEXT_PUBLIC_CAP_SERVER_URL=https://cap.sdtoll.de
NEXT_PUBLIC_CAP_SITE_KEY=7aa7d62f32
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFCmLsBloezlXcr2

NEXT_PUBLIC_MANGOE_URL=https://payments.mangoe.de
NEXT_PUBLIC_SITE_URL=https://gurkensekte.de
